# ============================================
# Quant - Environment Variables (Template)
# ============================================
# 사용법: 이 파일을 .env로 복사한 뒤 실제 값으로 채우세요.
#   cp .env.example .env
# .env는 절대 커밋 금지 (.gitignore에 등록됨)
# ============================================

# ----- Runtime -----
TZ=Asia/Seoul
LOG_LEVEL=INFO
APP_ENV=development              # development | production
DATA_DIR=/app/data
LOG_DIR=/app/logs

# ----- KIS Developers (한국투자증권) -----
# 발급: https://apiportal.koreainvestment.com/
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=                  # 형식: 12345678-01
KIS_MODE=paper                   # paper(모의) | live(실전)

# 모의투자/실전 base URL (보통 변경 불필요)
KIS_BASE_URL_PAPER=https://openapivts.koreainvestment.com:29443
KIS_BASE_URL_LIVE=https://openapi.koreainvestment.com:9443

# ----- Phase 2: 뉴스/공시 (지금은 비워둬도 무방) -----
# OpenDART (전자공시): https://opendart.fss.or.kr/
DART_API_KEY=

# 네이버 검색 API: https://developers.naver.com/
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ----- Phase 2: NLP (LLM 감성분석, 선택) -----
# 사용 시 ANTHROPIC_API_KEY 또는 OPENAI_API_KEY 중 하나
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ----- Jupyter -----
JUPYTER_TOKEN=changeme           # 외부 노출 시 반드시 변경
JUPYTER_PORT=8888
