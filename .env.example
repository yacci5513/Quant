# ============================================
# Quant - Environment Variables (Template)
# ============================================
# 사용법: 이 파일을 .env로 복사한 뒤 실제 값으로 채우세요.
#   cp .env.example .env
# .env는 절대 커밋 금지 (.gitignore에 등록됨)
# ============================================

# ----- Runtime -----
TZ=Asia/Seoul
LOG_LEVEL=INFO
APP_ENV=development              # development | production
DATA_DIR=/app/data
LOG_DIR=/app/logs

# ----- KIS Developers (한국투자증권) -----
# 발급: https://apiportal.koreainvestment.com/
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=                  # 형식: 12345678-01
KIS_MODE=paper                   # paper(모의) | live(실전)

# 모의투자/실전 base URL (보통 변경 불필요)
KIS_BASE_URL_PAPER=https://openapivts.koreainvestment.com:29443
KIS_BASE_URL_LIVE=https://openapi.koreainvestment.com:9443

# ----- 운용 자금 (시드) -----
# 매매 시 종목당 매수 금액 = SEED_WON / 10
# 단계적 증액 권장: 처음 30~50% → 1~2개월 검증 후 증액
# 0이면 매매 자동 차단 (안전 장치)
SEED_WON=0

# 단일 종목 한도 (선택, 0=SEED_WON/10 자동)
MAX_POSITION_PER_STOCK_WON=0

# ----- 전략 옵션 -----
# True: 다중 레짐 #6 (강세=모멘텀, 약세=저변동성 보유) - B 정책
# False: 단일 모멘텀 + MA100 청산 - A 정책 (안전)
STRATEGY_MULTI_REGIME=false

# 리밸런싱 빈도: BMS(월간) | 2W-FRI(격주) | BQS(분기)
STRATEGY_FREQ=BMS

# ----- DART (전자공시) -----
# 발급: https://opendart.fss.or.kr/
DART_API_KEY=

# ----- Telegram 알림 (선택) -----
# 봇 생성: @BotFather에서 /newbot
# chat_id: 봇과 대화 후 https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
